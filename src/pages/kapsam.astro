---
import BaseLayout from '../layouts/BaseLayout.astro';
import { istatistik, SIDDETLER } from '../lib/veri';

const ist = istatistik();
const dogrulananToplam = ist.durumlar.find((d) => d.id === 'dogrulandi')?.sayi ?? 0;
const oran = ist.toplamKod ? Math.round((dogrulananToplam / ist.toplamKod) * 100) : 0;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Veri kapsamı',
  url: 'https://forklifthata.com/kapsam/',
  inLanguage: 'tr',
  description: 'Forklift hata kodu veri tabanının marka, seri ve doğrulama durumu bazında kapsamı.',
};
---

<BaseLayout
  title="Kapsam — Hangi Marka ve Seriler Var?"
  description="Forklift hata kodu veri tabanının marka, seri, sistem ve doğrulama durumu bazında güncel kapsam raporu."
  canonical="/kapsam/"
  jsonLd={jsonLd}
>
  <div class="sarmal">
    <div class="breadcrumb" style="padding-inline:0">
      <a href="/">Ana Sayfa</a><span aria-hidden="true">/</span><span aria-current="page">Kapsam</span>
    </div>

    <section class="bolum" style="padding-top:1.5rem">
      <span class="eyek">// VERİ KAPSAMI</span>
      <h1>Kapsam ve doğrulama durumu</h1>
      <p class="muted" style="max-width:70ch">
        Her kayıt kaynak belge ve sayfa bilgisiyle ilişkilendirilir. "Doğrulandı" durumu, kaydın en az bir servis kılavuzu kaynağıyla karşılaştırıldığını; "incelemede" ve "taslak" durumları ise henüz tam doğrulanmadığını gösterir.
      </p>

      <div class="istatistik-kutulari" style="margin-top:2rem">
        <div class="istatistik-kutusu">
          <div class="istatistik-deger">{ist.toplamKod}</div>
          <div class="istatistik-etiket">toplam kayıt</div>
        </div>
        <div class="istatistik-kutusu">
          <div class="istatistik-deger">{ist.seriSayisi}</div>
          <div class="istatistik-etiket">tanımlı seri</div>
        </div>
        <div class="istatistik-kutusu">
          <div class="istatistik-deger">{ist.markaSayisi}</div>
          <div class="istatistik-etiket">izlenen marka</div>
        </div>
        <div class="istatistik-kutusu">
          <div class="istatistik-deger">%{oran}</div>
          <div class="istatistik-etiket">doğrulanmış kayıt</div>
        </div>
      </div>
    </section>

    <section class="bolum">
      <div class="bolum-basligi">
        <div>
          <span class="eyek">01 / MARKA → SERİ</span>
          <h2>Marka ve seri dağılımı</h2>
        </div>
        <p>Seri adı, kaynak belge ve kayıt durumlarının dağılımı.</p>
      </div>

      {ist.markalar.map((marka) => (
        <section class="kapsam-marka" aria-labelledby={`kapsam-${marka.id}`}>
          <div class="kapsam-marka-baslik">
            <h3 id={`kapsam-${marka.id}`}><a href={`/${marka.id}/`}>{marka.ad}</a></h3>
            <span class="seriesay">{marka.seriSayisi} seri · {marka.kodSayisi} kod</span>
          </div>
          <div class="kapsam-seriler">
            {marka.seriler.length ? marka.seriler.map((seri) => {
              const toplam = Math.max(seri.kodSayisi, 1);
              return (
                <div class="kapsam-seri">
                  <a href={`/${seri.marka}/${seri.seri}/`}>{seri.modelAdi}</a>
                  <span class="muted mono kucuk">{seri.kaynakBelge}</span>
                  <span class="ckubuk" aria-hidden="true">
                    <i style={`width:${(seri.dogrulanan / toplam) * 100}%;background:var(--durum-dogrulandi)`}></i>
                    <i style={`width:${(seri.incelemede / toplam) * 100}%;background:var(--durum-incelemede)`}></i>
                    <i style={`width:${(seri.taslak / toplam) * 100}%;background:var(--durum-taslak)`}></i>
                  </span>
                  <span class="sayilar">
                    <span><b>{seri.kodSayisi}</b> kayıt</span>
                    <span class="durum-dogrulandi"><b>{seri.dogrulanan}</b> doğrulandı</span>
                    <span class="durum-incelemede"><b>{seri.incelemede}</b> incelemede</span>
                    <span class="durum-taslak"><b>{seri.taslak}</b> taslak</span>
                  </span>
                </div>
              );
            }) : (
              <div class="kapsam-seri muted">Bu marka için henüz seri verisi eklenmedi. Veri geldikçe burada listelenir.</div>
            )}
          </div>
        </section>
      ))}
    </section>

    <section class="bolum">
      <div class="bolum-basligi">
        <div>
          <span class="eyek">02 / DAĞILIM</span>
          <h2>Sistem ve şiddet dağılımı</h2>
        </div>
        <p>Kayıtların hangi sistemlere ve şiddet seviyelerine ait olduğunu gösterir.</p>
      </div>

      <div class="kartlar">
        <div class="panel">
          <h2>Sistemlere göre</h2>
          <ul style="list-style:none;padding:0;margin:0">
            {ist.sistemler.map((s) => (
              <li class="kaynak-satiri">
                <span>{s.ad}</span>
                <span class="mono">{s.sayi}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="panel">
          <h2>Şiddet seviyelerine göre</h2>
          <ul style="list-style:none;padding:0;margin:0">
            {ist.siddetler.map((s) => (
              <li class="kaynak-satiri">
                <span><span class="durum-rozet" style={`color:${s.renk}`}>{s.ad}</span></span>
                <span class="mono">{s.sayi}</span>
              </li>
            ))}
          </ul>
          <p class="kucuk muted" style="margin-top:1rem">
            Şiddet renkleri: {Object.entries(SIDDETLER).map(([id, v]) => `${v.ad} (${id})`).join(' · ')}.
          </p>
        </div>
      </div>
    </section>

    <section class="bolum">
      <div class="sarmal-dar uyari-kutusu">
        Kapsam rakamları derleme anındaki veri dosyalarından üretilir. Eksik veya "incelemede" işaretli kayıtlar için üretici servis kılavuzu esas alınmalıdır. <a href="/kaynaklar/">Kaynak politikasını okuyun →</a>
      </div>
    </section>
  </div>
</BaseLayout>
